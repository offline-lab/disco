#!/bin/sh
set -e

case "$1" in
    configure)
        # Create disco user and group if they don't exist
        if ! getent passwd disco > /dev/null; then
            adduser --system --group --home /var/lib/disco \
                    --gecos "Disco daemon" --shell /bin/false disco
        fi

        # Create required directories
        mkdir -p /var/lib/disco
        mkdir -p /run/disco
        chown disco:disco /var/lib/disco
        chown disco:disco /run/disco

        # Install default config if not present
        if [ ! -f /etc/disco/config.yaml ]; then
            cp /etc/disco/config.yaml.example /etc/disco/config.yaml
            chmod 640 /etc/disco/config.yaml
            chown root:disco /etc/disco/config.yaml
        fi

        # Update ldconfig for NSS module
        ldconfig

        # Remind user to configure nsswitch.conf
        if ! grep -q "disco" /etc/nsswitch.conf; then
            echo ""
            echo "Disco has been installed. Add 'disco' to /etc/nsswitch.conf."
            echo "'disco' must appear immediately after 'files' and before"
            echo "any 'resolve [!UNAVAIL=return]' entry — if placed after it,"
            echo "the [!UNAVAIL=return] action stops the chain on NOTFOUND"
            echo "and disco is never reached."
            echo ""
            if [ -f /run/systemd/resolve/resolv.conf ]; then
                echo "systemd-resolved detected. Recommended hosts line:"
                echo "  hosts: files disco resolve [!UNAVAIL=return] dns myhostname"
            else
                echo "Recommended hosts line:"
                echo "  hosts: files disco dns"
            fi
            echo ""
            echo "Then start the daemon:"
            echo "  systemctl enable disco-daemon"
            echo "  systemctl start disco-daemon"
            echo ""
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
